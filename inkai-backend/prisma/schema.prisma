// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Province {
  id        String   @id @default(uuid())
  name      String   @unique
  headName  String?
  branches  Branch[]
  admins    User[]   @relation("ProvinceAdmin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  city       String?
  headName   String?
  province   Province @relation(fields: [provinceId], references: [id])
  provinceId String
  dojos      Dojo[]
  admins     User[]   @relation("BranchAdmin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)

  @@unique([name, provinceId])
}

model Dojo {
  id            String       @id @default(uuid())
  name          String
  address       String?
  kecamatan     String?
  tempatLatihan String?
  phoneNumber   String?
  schedule      String?
  contactPerson String?
  branch        Branch       @relation(fields: [branchId], references: [id])
  branchId      String
  members       Member[]
  attendances   Attendance[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  isDeleted     Boolean      @default(false)

  @@unique([name, branchId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  phoneNumber  String?
  isActive     Boolean  @default(true)
  member       Member?
  roles        Role[]   @relation("UserRoles")
  notifications Notification[]
  childrenMembers Member[] @relation("ParentChildren")
  fullName     String?
  photoUrl     String?
  resetToken   String?  @unique
  resetTokenExpiry DateTime?
  managedProvinceId String?
  managedProvince   Province? @relation("ProvinceAdmin", fields: [managedProvinceId], references: [id])
  managedBranchId   String?
  managedBranch     Branch?   @relation("BranchAdmin", fields: [managedBranchId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted    Boolean  @default(false)
  conversations Conversation[] @relation("UserConversations")
  messages      Message[]
}


model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  users       User[]           @relation("UserRoles")
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique // e.g., "Dashboard", "Anggota"
  slug  String           @unique // e.g., "dashboard", "members"
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Member {
  id                 String              @id @default(uuid())
  user               User?               @relation(fields: [userId], references: [id])
  userId             String?             @unique
  dojo               Dojo                @relation(fields: [dojoId], references: [id])
  dojoId             String
  nia                String?             @unique
  fullName           String
  gender             String?
  birthDate          DateTime?
  currentRank        String              @default("Putih")
  status             String              @default("Active")
  attendances        Attendance[]
  billings           Billing[]
  eventRegistrations EventRegistration[]
  verifications      Verification[]
  ranks              MemberRank[]
  parentUserId       String?
  parentUser         User?               @relation("ParentChildren", fields: [parentUserId], references: [id])
  birthCertificateUrl String?
  bpjsCardUrl        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isDeleted          Boolean             @default(false)
}

model MemberRank {
  id        String   @id @default(uuid())
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  rank      String
  date      DateTime
  location  String?
  isVerified Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Attendance {
  id         String   @id @default(uuid())
  member     Member   @relation(fields: [memberId], references: [id])
  memberId   String
  dojo       Dojo     @relation(fields: [dojoId], references: [id])
  dojoId     String
  checkInAt  DateTime @default(now())
  method     String   @default("QR_SCAN") // QR_SCAN, MANUAL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)
}

model Billing {
  id        String   @id @default(uuid())
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  type      String   // MONTHLY_IURAN, EVENT_FEE
  amount    Float
  dueDate   DateTime
  status    String   @default("PENDING") // PENDING, PAID, FAILED
  payment   Payment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Payment {
  id            String   @id @default(uuid())
  billing       Billing  @relation(fields: [billingId], references: [id])
  billingId     String   @unique
  paymentMethod String?
  externalId    String?  @unique
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id           String              @id @default(uuid())
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime
  location     String?
  registrations EventRegistration[]
  verifications Verification[]
  categories    EventCategory[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  isDeleted    Boolean             @default(false)
}

model EventCategory {
  id      String @id @default(uuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
  name    String
  fee     Float
}

model EventRegistration {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Verification {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  type        String   // RANK_PROMOTION, DOJO_TRANSFER, ACHIEVEMENT
  data        String   // New rank, new dojo, or achievement title
  proofUrl    String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes  String?
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id            String    @id @default(uuid())
  participants  User[]    @relation("UserConversations")
  messages      Message[]
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}
