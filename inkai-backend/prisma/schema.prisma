generator client {
  provider      = "prisma-client-js"
  /// Wajib untuk deploy Vercel / Lambda (OpenSSL 3). Lokal tetap pakai target `native`.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Koneksi langsung (Supabase :5432) untuk migrasi; DATABASE_URL boleh pooler :6543 + pgbouncer.
  directUrl = env("DIRECT_URL")
}

model Province {
  id        String   @id @default(uuid())
  name      String   @unique
  headName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  branches  Branch[]
  admins    User[]   @relation("ProvinceAdmin")
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  city       String?
  provinceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  headName   String?
  isDeleted  Boolean  @default(false)
  province   Province @relation(fields: [provinceId], references: [id])
  dojos      Dojo[]
  admins     User[]   @relation("BranchAdmin")
  events     Event[]

  @@unique([name, provinceId])
}

model Dojo {
  id            String       @id @default(uuid())
  name          String
  address       String?
  contactPerson String?
  branchId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  kecamatan     String?
  phoneNumber   String?
  schedule      String?
  tempatLatihan String?
  isDeleted     Boolean      @default(false)
  headName      String?
  latitude      Float?
  longitude     Float?
  geofenceRadius Int         @default(50) // Default 50 meters
  attendances   Attendance[]
  branch        Branch       @relation(fields: [branchId], references: [id])
  members       Member[]
  admins        User[]       @relation("DojoAdmin")

  @@unique([name, branchId])
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  phoneNumber       String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  isDeleted         Boolean        @default(false)
  fullName          String?
  managedBranchId   String?
  managedProvinceId String?
  managedDojoId     String?
  photoUrl          String?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  childrenMembers   Member[]       @relation("ParentChildren")
  member            Member?
  messages          Message[]
  notifications     Notification[]
  managedBranch     Branch?        @relation("BranchAdmin", fields: [managedBranchId], references: [id])
  managedProvince   Province?      @relation("ProvinceAdmin", fields: [managedProvinceId], references: [id])
  managedDojo       Dojo?          @relation("DojoAdmin", fields: [managedDojoId], references: [id])
  conversations     Conversation[] @relation("UserConversations")
  roles             Role[]         @relation("UserRoles")
  events            Event[]        @relation("UserEvents")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  permissions RolePermission[]
  users       User[]           @relation("UserRoles")
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique
  slug  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model Member {
  id                  String              @id @default(uuid())
  userId              String?             @unique
  dojoId              String
  nia                 String?             @unique
  nik                 String?             @unique
  fullName            String
  gender              String?
  birthPlace          String?
  birthDate           DateTime?
  address             String?
  currentRank         String              @default("Putih")
  status              String              @default("Active")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  isDeleted           Boolean             @default(false)
  parentUserId        String?
  birthCertificateUrl String?
  bpjsCardUrl         String?
  bpjsCardNumber      String?
  bpjsOcrExtracted    Json?
  attendances         Attendance[]
  billings            Billing[]
  eventRegistrations  EventRegistration[]
  dojo                Dojo                @relation(fields: [dojoId], references: [id])
  parentUser          User?               @relation("ParentChildren", fields: [parentUserId], references: [id])
  user                User?               @relation(fields: [userId], references: [id])
  ranks               MemberRank[]
  verifications       Verification[]
}

model MemberRank {
  id         String   @id @default(uuid())
  memberId   String
  rank       String
  date       DateTime
  location   String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id])
}

model Attendance {
  id        String   @id @default(uuid())
  memberId  String
  dojoId    String
  checkInAt DateTime @default(now())
  method    String   @default("QR_SCAN")
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  dojo      Dojo     @relation(fields: [dojoId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])
}

model Billing {
  id             String   @id @default(uuid())
  memberId       String
  registrationId String?
  type           String
  amount         Float
  description    String?
  dueDate        DateTime
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isDeleted      Boolean  @default(false)
  member         Member   @relation(fields: [memberId], references: [id])
  payment        Payment?
}

model Payment {
  id            String    @id @default(uuid())
  billingId     String    @unique
  paymentMethod String?
  externalId    String?   @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  billing       Billing   @relation(fields: [billingId], references: [id])
}

model Event {
  id            String              @id @default(uuid())
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  branchId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  isDeleted     Boolean             @default(false)
  createdById   String?
  createdBy     User?               @relation("UserEvents", fields: [createdById], references: [id])
  branch        Branch?             @relation(fields: [branchId], references: [id])
  categories    EventCategory[]
  registrations EventRegistration[]
  verifications Verification[]
}

model EventCategory {
  id      String @id @default(uuid())
  eventId String
  name    String
  fee     Float
  event   Event  @relation(fields: [eventId], references: [id])
  registrations EventRegistration[]
}

model EventRegistration {
  id         String        @id @default(uuid())
  eventId    String
  memberId   String
  /// User akun yang mencatat pendaftaran: anggota sendiri saat mandiri, atau pengurus saat bulk.
  registeredByUserId String?
  categoryId String?
  status     String        @default("PENDING")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  category   EventCategory? @relation(fields: [categoryId], references: [id])
  event      Event         @relation(fields: [eventId], references: [id])
  member     Member        @relation(fields: [memberId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("INFO")
  userId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Verification {
  id         String   @id @default(uuid())
  memberId   String
  type       String
  data       String
  proofUrl   String
  status     String   @default("PENDING")
  adminNotes String?
  eventId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  event      Event?   @relation(fields: [eventId], references: [id])
  member     Member   @relation(fields: [memberId], references: [id])
}

model Conversation {
  id            String    @id @default(uuid())
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  messages      Message[]
  participants  User[]    @relation("UserConversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

/// Key-value app configuration (e.g. mobile member welcome guide JSON)
model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
