PORT=5001

# --- Supabase (lihat https://supabase.com/docs/guides/database/connecting-to-postgres) ---
#
# • DIRECT_URL — koneksi langsung Postgres (migrate / introspection). IPv6; dari mesin lokal/CI.
#   postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#
# • DATABASE_URL di Vercel/serverless — Supavisor TRANSACTION mode (bukan Session di aws-…pooler):
#   user SELALU `postgres` (bukan postgres.PROJECT_REF). Host = db.PROJECT_REF.supabase.co, port 6543.
#   postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres?sslmode=require&pgbouncer=true
#   (Prisma: ?pgbouncer=true wajib untuk mematikan prepared statements di mode transaction.)
#
# • Session mode (alternatif IPv4, backend panjang): postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/...
#
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/inkai_db?schema=public"

# Dipakai `prisma/schema.prisma` (directUrl) untuk `migrate deploy` — URL direct :5432, user `postgres`.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/inkai_db?schema=public"

# Catatan: jangan samakan Session pooler (aws-…:5432 + user postgres.ref) dengan Transaction
# (db.…:6543 + user postgres). Salah kombinasi → "tenant/user … not found".

JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"
NODE_ENV=development

# Observability (opsional)
# SENTRY_DSN="https://....@......ingest.us.sentry.io/...."
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# Rate limit login / admin-login (memori lokal jika Redis tidak diset)
# Dengan Upstash: limit dipakai bersama semua function Vercel.
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
# AUTH_LOGIN_RATE_MAX_REQUESTS="25"
# AUTH_LOGIN_RATE_WINDOW_MS="900000"
# Saat Redis error: true = izinkan request (default), false = blokir
# AUTH_LOGIN_PASS_ON_STORE_ERROR="true"

# Di belakang Vercel, trust proxy diaktif otomatis:
# TRUST_PROXY="true"
