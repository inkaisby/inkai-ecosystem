PORT=5001

# Postgres / Supabase
# Produksi/serverless (Vercel): gunakan CONNECTION POOLER Supabase → biasanya hostname `*.pooler.supabase.com`,
# port 6543, dan query `?pgbouncer=true` (kadang juga `connection_limit=1`). Lihat Dashboard Supabase → Database → Connection pooling.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/inkai_db?schema=public"

# Migrasi Prisma secara ideal dijalankan dengan koneksi LANGSUNG (port 5432), bukan pooler —
# bisa set DATABASE_URL langsung ketika menjalankan `prisma migrate`, atau pisahkan variabel manual di CI.
# Contoh pola pooler (tidak jalankan migrate hanya dengan URL ini tanpa dokumentasi vendor):
# DATABASE_URL="postgresql://USER.POOLER_PROJECT:PASSWORD@aws-XXX.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"
NODE_ENV=development

# Observability (opsional)
# SENTRY_DSN="https://....@......ingest.us.sentry.io/...."
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# Rate limit login / admin-login (memori lokal jika Redis tidak diset)
# Dengan Upstash: limit dipakai bersama semua function Vercel.
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
# AUTH_LOGIN_RATE_MAX_REQUESTS="25"
# AUTH_LOGIN_RATE_WINDOW_MS="900000"
# Saat Redis error: true = izinkan request (default), false = blokir
# AUTH_LOGIN_PASS_ON_STORE_ERROR="true"

# Di belakang Vercel, trust proxy diaktif otomatis:
# TRUST_PROXY="true"
